{
  "name": "site-cicd",
  "version": "1.0.0",
  "private": true,
  "description": "Лендинг InJazz с автодеплоем через GitHub Actions",
  "scripts": {
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint": "npm run lint:html && npm run lint:css"
  },
  "devDependencies": {
    "htmlhint": "1.9.2",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "14.0.1"
  }
}
